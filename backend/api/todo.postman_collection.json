{
  "info": {
    "name": "Todo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create todo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare assignment\",\n  \"description\": \"Backend + frontend\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-12-31\"\n}"
        }
      }
    },
    {
      "name": "List todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos?status=active&sort=priority&order=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get todo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "1"
          ]
        }
      }
    },
    {
      "name": "Update todo",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/todos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        }
      }
    },
    {
      "name": "Delete todo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos",
            "1"
          ]
        }
      }
    },
    {
      "name": "Clear completed",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/todos?completed=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos"
          ]
        }
      }
    }
  ]
}